{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://github.com/Heaifan/XYLab/blob/main/schema/experiment.schema.json",
  "title": "XYLab Experiment 0.1",
  "description": "XYLab 实验协议 0.1 机器校验 Schema（严格模式：未知字段报错）。人类可读契约见 docs/experiment-protocol-0.1.md",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "experiment", "timeline"],
  "properties": {
    "schema": {
      "type": "string",
      "const": "xylab-experiment@0.1"
    },
    "experiment": {
      "$ref": "#/definitions/experiment"
    },
    "variables": {
      "type": "object",
      "propertyNames": {
        "pattern": "^[a-z][a-z0-9_]*$"
      },
      "additionalProperties": {
        "$ref": "#/definitions/variable"
      }
    },
    "entities": {
      "type": "array",
      "items": {
        "$ref": "#/definitions/entity"
      }
    },
    "formulas": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/definitions/formula"
      }
    },
    "timeline": {
      "$ref": "#/definitions/timeline"
    },
    "watch": {
      "type": "array",
      "items": {
        "$ref": "#/definitions/watch"
      }
    },
    "events": {
      "type": "array",
      "items": {
        "$ref": "#/definitions/event"
      }
    },
    "output": {
      "$ref": "#/definitions/output"
    },
    "random": {
      "type": "object",
      "additionalProperties": false,
      "required": ["seed"],
      "properties": {
        "seed": {
          "type": "number"
        }
      }
    }
  },
  "definitions": {
    "experiment": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "name"],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[a-z0-9][a-z0-9._-]*$"
        },
        "name": {
          "type": "string",
          "minLength": 1
        },
        "description": {
          "type": "string"
        },
        "category": {
          "type": "string"
        },
        "version": {
          "type": "string"
        },
        "tags": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "author": {
          "type": "string"
        },
        "created_at": {
          "type": "string",
          "format": "date-time"
        }
      }
    },
    "variable": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type", "value"],
      "properties": {
        "type": {
          "enum": ["number", "integer", "boolean", "enum", "string"]
        },
        "value": {},
        "label": {
          "type": "string"
        },
        "unit": {
          "type": "string"
        },
        "min": {
          "type": "number"
        },
        "max": {
          "type": "number"
        },
        "step": {
          "type": "number"
        },
        "options": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "type": {
                "const": "enum"
              }
            }
          },
          "then": {
            "required": ["options"]
          }
        }
      ]
    },
    "entity": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id"],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[a-z0-9][a-z0-9_-]*$"
        },
        "name": {
          "type": "string"
        },
        "type": {
          "type": "string"
        },
        "state": {
          "type": "object",
          "additionalProperties": {
            "type": "number"
          }
        }
      }
    },
    "formula": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "target", "expression"],
      "properties": {
        "id": {
          "type": "string"
        },
        "target": {
          "type": "string",
          "minLength": 1
        },
        "expression": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "timeline": {
      "type": "object",
      "additionalProperties": false,
      "required": ["mode", "tick", "duration"],
      "properties": {
        "mode": {
          "const": "fixed_tick"
        },
        "tick": {
          "type": "number",
          "exclusiveMinimum": 0
        },
        "duration": {
          "type": "number",
          "exclusiveMinimum": 0
        }
      }
    },
    "watch": {
      "type": "object",
      "additionalProperties": false,
      "required": ["target", "mode"],
      "properties": {
        "target": {
          "type": "string",
          "minLength": 1
        },
        "mode": {
          "enum": ["value", "change", "threshold"]
        },
        "threshold": {
          "type": "number"
        },
        "operator": {
          "enum": [">=", ">", "<=", "<", "==", "!="]
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "mode": {
                "const": "threshold"
              }
            }
          },
          "then": {
            "required": ["threshold"]
          }
        }
      ]
    },
    "event": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "when"],
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "when": {
          "type": "string",
          "minLength": 1
        },
        "message": {
          "type": "string"
        },
        "level": {
          "enum": ["trace", "info", "notice", "warning", "critical"]
        },
        "repeat": {
          "type": "boolean"
        }
      }
    },
    "output": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "summary": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "charts": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["x", "y"],
            "properties": {
              "x": {
                "type": "string"
              },
              "y": {
                "type": "string"
              }
            }
          }
        }
      }
    }
  }
}
